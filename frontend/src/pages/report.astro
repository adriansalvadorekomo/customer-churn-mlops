---
import Base from "../layouts/Base.astro";
import Stamp from "../components/Stamp.astro";
import ArrowUpRight from "../components/ArrowUpRight.astro";

// Verified evaluation run — see README ("Accuracy score: 85.55").
// Holdout: 2,000 cases (test_size 0.2, random_state 1), model seed 42.
const accuracy = "85.55";
const report = [
  { label: "Stays (0)", precision: "0.87", recall: "0.97", f1: "0.91", support: "1,585" },
  { label: "Leaves (1)", precision: "0.78", recall: "0.42", f1: "0.55", support: "415" },
];
const matrix = [
  { actual: "Stays (0)", counts: [1535, 50] },
  { actual: "Leaves (1)", counts: [239, 176] },
];
const maxCount = 1535;
const density = (count: number) => Math.max(0.07, (count / maxCount) * 0.9);
---

<Base
  title="Churn Desk — Model report"
  description="Verified evaluation figures for the RandomForest churn classifier: accuracy, classification report, and confusion matrix."
>
  <div class="mx-auto w-full max-w-6xl px-5 pt-6 lg:px-8 lg:pt-8">
    <article class="case-file panel-paper sheet-fit flex flex-col p-6 sm:p-8">
      <div class="rule-b flex flex-wrap items-baseline justify-between gap-3 pb-3">
        <span class="mono-label text-ink-soft">model report · evaluation dossier</span>
        <span class="mono-label text-ink-soft">randomforest · churn</span>
      </div>

      <div class="mt-4 flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
        <h1
          class="text-[2.05rem] font-extrabold leading-[1.02] tracking-[-0.022em] text-ink sm:text-[2.5rem]"
        >
          Model report
        </h1>
        <p class="desk-optional max-w-[56ch] text-[0.88rem] leading-relaxed text-ink-soft">
          Every figure comes from the repo's verified evaluation run —
          reproduce it with
          <code class="font-mono text-[0.9em] text-carbon"
            >uv run python main.py --flow evaluat</code
          >.
        </p>
      </div>

      <div
        class="mt-5 grid grid-cols-1 gap-8 lg:min-h-0 lg:flex-1 lg:grid-cols-12 lg:overflow-y-auto lg:pr-1"
      >
        <div class="report-col lg:col-span-7">
          <div>
            <p
              class="group-rule text-[0.7rem] font-bold uppercase tracking-[0.16em] text-ink"
            >
              Result
            </p>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
              <p class="mono-label text-ink-soft">
                test accuracy · 2,000-case holdout
              </p>
              <div class="flex items-center gap-5">
                <span
                  class="font-mono text-[2.4rem] font-bold leading-none text-ink"
                  >{accuracy}<span class="text-[1.3rem] text-ink-soft">%</span></span
                >
                <Stamp text="Verified" verdict="stays" size="sm" />
              </div>
            </div>
          </div>

          <div>
            <p
              class="group-rule text-[0.7rem] font-bold uppercase tracking-[0.16em] text-ink"
            >
              Classification report
            </p>
            <div class="mt-3 overflow-x-auto">
              <table class="doc-table">
                <thead>
                  <tr>
                    <th>Class</th>
                    <th class="num">Precision</th>
                    <th class="num">Recall</th>
                    <th class="num">F1</th>
                    <th class="num">Support</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    report.map((row) => (
                      <tr>
                        <td>{row.label}</td>
                        <td class="num">{row.precision}</td>
                        <td class="num">{row.recall}</td>
                        <td class="num">{row.f1}</td>
                        <td class="num">{row.support}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>

          <div>
            <p
              class="group-rule text-[0.7rem] font-bold uppercase tracking-[0.16em] text-ink"
            >
              Confusion matrix
            </p>
            <div class="mt-3 overflow-x-auto">
              <table class="w-full border-collapse">
                <caption class="sr-only">
                  Confusion matrix — rows: actual outcome, columns: model
                  prediction, over the 2,000-case holdout.
                </caption>
                <thead>
                  <tr>
                    <td></td>
                    <th scope="col" class="matrix-head text-left">
                      predicted stays
                    </th>
                    <th scope="col" class="matrix-head text-left">
                      predicted leaves
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {
                    matrix.map((row) => (
                      <tr>
                        <th
                          scope="row"
                          class="matrix-head pr-3 text-right align-middle sm:pr-4"
                        >
                          <span class="block text-[0.85em] opacity-75">
                            actual
                          </span>
                          <span class="whitespace-nowrap">{row.actual}</span>
                        </th>
                        {row.counts.map((count) => {
                          const d = density(count);
                          return (
                            <td
                              class="matrix-cell"
                              style={`--d:${d.toFixed(3)}`}
                              data-dark={d > 0.5 ? "" : undefined}
                            >
                              {count.toLocaleString("en-US")}
                            </td>
                          );
                        })}
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <p
              class="matrix-note mt-2 max-w-[68ch] font-mono text-[0.72rem] leading-relaxed text-ink-soft"
            >
              Rows: actual outcome · columns: prediction · shade scales with
              count. The 239 lower-left: churners rated “stays” — the main
              failure mode.
            </p>
          </div>
        </div>

        <div class="report-col lg:col-span-5">
          <div>
            <p
              class="group-rule text-[0.7rem] font-bold uppercase tracking-[0.16em] text-ink"
            >
              Identification
            </p>
            <dl class="mt-3">
              {
                [
                  ["Model", "RandomForestClassifier · 100 trees"],
                  ["Artifact", "models/classifier.joblib"],
                  ["Training data", "Churn_Modelling.csv · 10,000 rows"],
                  ["Holdout", "2,000 cases · test_size 0.2 · seed 1"],
                  ["Model seed", "random_state 42"],
                ].map(([term, value]) => (
                  <div class="rule-b ident-row flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 last:border-b-0">
                    <dt class="mono-label text-ink-soft">{term}</dt>
                    <dd class="font-mono text-[0.86rem] text-ink">{value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <div>
            <p
              class="group-rule text-[0.7rem] font-bold uppercase tracking-[0.16em] text-ink"
            >
              Trace the numbers
            </p>
            <ul class="trace-list mt-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
              <li class="flex items-baseline gap-2">
                <span class="mono-label text-ink-soft">runs</span>
                <a
                  class="font-mono text-[0.82rem] text-carbon underline decoration-dotted hover:text-ink"
                  href="http://localhost:5000"
                  target="_blank"
                  rel="noopener">mlflow :5000 <ArrowUpRight /></a
                >
              </li>
              <li class="flex items-baseline gap-2">
                <span class="mono-label text-ink-soft">pipeline</span>
                <a
                  class="font-mono text-[0.82rem] text-carbon underline decoration-dotted hover:text-ink"
                  href="http://localhost:4200"
                  target="_blank"
                  rel="noopener">prefect :4200 <ArrowUpRight /></a
                >
              </li>
              <li class="flex items-baseline gap-2">
                <span class="mono-label text-ink-soft">api</span>
                <a
                  class="font-mono text-[0.82rem] text-carbon underline decoration-dotted hover:text-ink"
                  href="http://localhost:8000/docs"
                  target="_blank"
                  rel="noopener">fastapi /docs <ArrowUpRight /></a
                >
              </li>
              <li class="desk-optional flex items-baseline gap-2 xl:col-span-2">
                <span class="mono-label text-ink-soft">artifact</span>
                <span class="font-mono text-[0.82rem] text-ink"
                  >models/classifier.joblib</span
                >
              </li>
            </ul>
          </div>

          <div class="rounded-[3px] border border-ink/35 p-4">
            <div class="flex flex-wrap items-center gap-3">
              <Stamp text="Caution" verdict="leaves" size="sm" />
              <p class="mono-label text-ink-soft">read before trusting the score</p>
            </div>
            <p class="caution-note mt-3 max-w-[68ch] leading-relaxed text-ink-soft">
              79.6% of customers in the dataset stayed, so a blanket “stays”
              already scores ~80%. The model catches only 42% of the leavers
              that actually churn (recall 0.42 on class 1) — at this threshold,
              nearly six in ten churners slip through. The matrix shows exactly
              where they go. Documented next step in the repo: OneHot-encode
              <code class="font-mono text-[0.88em] text-carbon">Geography</code>
              and try class weights.
            </p>
          </div>
        </div>
      </div>
    </article>
  </div>
</Base>
