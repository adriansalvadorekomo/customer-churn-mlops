# One image, two services: the API (default CMD) and the Prefect worker
# (docker-compose overrides the command). Ships code + the trained model;
# the worker mounts notebooks/data and models for scheduled runs.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# git is here for parity with the fetch-source-code task (skipped in
# container mode — the image is the source).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY tests ./tests
COPY models ./models
COPY main.py deploiement_prefect.py ./

EXPOSE 8000

CMD ["uvicorn", "src.app:app", "--host", "0.0.0.0", "--port", "8000"]
